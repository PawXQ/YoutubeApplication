<Application
    x:Class="YoutubeApplication.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YoutubeApplication"
    StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!--  =====================================================================
             色彩：黑灰金屬風格（深炭黑 + 髮絲紋槍灰 + 鈦銀高光）
             ======================================================================  -->
        <Color x:Key="GlowColor">#D8DEE9</Color>

        <!--  背景 / 面板層級（由深到淺的金屬漸層）  -->
        <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#0C0C0E" />
            <GradientStop Offset="0.55" Color="#161619" />
            <GradientStop Offset="1" Color="#1F1F24" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#26262A" />
            <GradientStop Offset="1" Color="#1A1A1E" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelRaisedBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#323238" />
            <GradientStop Offset="1" Color="#232328" />
        </LinearGradientBrush>

        <!--  Popup / 頂部 Banner 專用金屬漸層  -->
        <LinearGradientBrush x:Key="BannerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#3A3A42" />
            <GradientStop Offset="0.5" Color="#2C2C32" />
            <GradientStop Offset="1" Color="#222227" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ControlBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#38383E" />
            <GradientStop Offset="1" Color="#28282D" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ControlHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#484850" />
            <GradientStop Offset="1" Color="#333339" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ControlPressedBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#222226" />
            <GradientStop Offset="1" Color="#2C2C32" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#121215" />

        <!--  金屬邊框（上緣反光、下緣沉穩）  -->
        <LinearGradientBrush x:Key="BorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#4DFFFFFF" />
            <GradientStop Offset="0.45" Color="#22FFFFFF" />
            <GradientStop Offset="1" Color="#12FFFFFF" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderStrongBrush" Color="#52545C" />
        <SolidColorBrush x:Key="DividerBrush" Color="#2E2F34" />

        <!--  文字  -->
        <SolidColorBrush x:Key="TextBrush" Color="#F2F3F5" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#A6A9B2" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#737680" />
        <SolidColorBrush x:Key="TextDarkBrush" Color="#121215" />

        <!--  主色：鈦銀金屬  -->
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#E6E8EC" />
            <GradientStop Offset="1" Color="#AEB3BD" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#C8CDD6" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryPressedBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#9DA2AC" />
            <GradientStop Offset="1" Color="#7E838D" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="HighlightBorderBrush" Color="#C8CDD6" />
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTintBrush" Color="#24FFFFFF" />

        <!--  =====================================================================
             效果：滑鼠移過的金屬銀白光暈 / 面板陰影
             ======================================================================  -->
        <DropShadowEffect
            x:Key="HoverGlow"
            BlurRadius="16"
            Opacity="0.45"
            ShadowDepth="0"
            Color="{StaticResource GlowColor}" />

        <DropShadowEffect
            x:Key="HoverGlowSoft"
            BlurRadius="22"
            Opacity="0.32"
            ShadowDepth="0"
            Color="{StaticResource GlowColor}" />

        <DropShadowEffect
            x:Key="PanelShadow"
            BlurRadius="28"
            Direction="270"
            Opacity="0.7"
            ShadowDepth="8"
            Color="#000000" />

        <!--  =====================================================================
             面板
             ======================================================================  -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!--  區塊小標題  -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  =====================================================================
             按鈕（參考圖中膠囊金屬按鈕）
             ======================================================================  -->
        <!--  一般金屬按鈕：槍灰漸層，滑過亮銀邊框 + 光暈  -->
        <Style x:Key="MinimalButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="17">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HighlightBorderBrush}" />
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource HoverGlow}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  切換按鈕：開啟時亮銀邊框 + 金屬反光底  -->
        <Style
            x:Key="MinimalToggleButton"
            BasedOn="{StaticResource MinimalButton}"
            TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="17">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HighlightBorderBrush}" />
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource HoverGlow}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HighlightBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主要按鈕：鈦銀金屬漸層 + 深色文字，滑過發光  -->
        <Style
            x:Key="PrimaryButton"
            BasedOn="{StaticResource MinimalButton}"
            TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border
                            x:Name="Bd"
                            Background="{StaticResource PrimaryBrush}"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1"
                            CornerRadius="17">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource HoverGlow}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  圓形圖示按鈕（箭頭用）  -->
        <Style
            x:Key="IconButton"
            BasedOn="{StaticResource MinimalButton}"
            TargetType="ButtonBase">
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!--  =====================================================================
             搜尋框（深炭黑輸入框，聚焦時金屬邊框 + 光暈）
             ======================================================================  -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="Bd"
                            Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            SnapsToDevicePixels="True">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="Icon"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Text="&#xE721;" />
                                <TextBlock
                                    x:Name="Watermark"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextDimBrush}"
                                    IsHitTestVisible="False"
                                    Text="Search videos..."
                                    Visibility="Collapsed" />
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HighlightBorderBrush}" />
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource HoverGlow}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  =====================================================================
             細捲軸
             ======================================================================  -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            x:Name="Bd"
                            Background="{StaticResource BorderStrongBrush}"
                            CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HighlightBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6" />
                    <Setter Property="MinWidth" Value="6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
