<UserControl
    x:Class="YoutubeApplication.Components.PlayListForAddVideoItem.PlayListForAddVideoItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApplication.Components.PlayListForAddVideoItem"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <UserControl.Resources>
        <!--  播放清單項目列：滑過時呈現微亮金屬底色  -->
        <Style x:Key="PlaylistItemRow" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  播放清單迷你 Add 按鈕（鈦銀金屬）  -->
        <Style
            x:Key="CompactPrimaryButton"
            BasedOn="{StaticResource PrimaryButton}"
            TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!--  播放清單迷你 Delete 按鈕（暗金屬紅，滑過亮紅光暈）  -->
        <Style
            x:Key="CompactDangerButton"
            BasedOn="{StaticResource MinimalButton}"
            TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#F29B94" />
            <Setter Property="BorderBrush" Value="#4DE04B3E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="13">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6B5E" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="14"
                                            Opacity="0.55"
                                            ShadowDepth="0"
                                            Color="#E04B3E" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9E2216" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border
        Width="320"
        Margin="12"
        CornerRadius="10"
        Effect="{StaticResource PanelShadow}"
        Style="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Popup 頂部 Banner：金屬漸層  -->
            <Border
                Grid.Row="0"
                Padding="14,10"
                Background="{StaticResource BannerBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="10,10,0,0">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Foreground="{StaticResource TextBrush}"
                        Text="&#xE8FD;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="Add to playlist" />
                </StackPanel>
            </Border>

            <!--  播放清單列表  -->
            <ScrollViewer
                Grid.Row="1"
                MaxHeight="260"
                Padding="8"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DataContext.PlayListDTOs, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PlaylistItemRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  PlayList 頭像  -->
                                    <Ellipse
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Stroke="{StaticResource BorderStrongBrush}"
                                        StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Thumbnails}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Title}" />

                                    <Button
                                        Grid.Column="2"
                                        Margin="8,0,4,0"
                                        Command="{Binding AddVideoItemPlayListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Add"
                                        Style="{StaticResource CompactPrimaryButton}" />
                                    <Button
                                        Grid.Column="3"
                                        Command="{Binding RemoveVideoItemPlayListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Delete"
                                        Style="{StaticResource CompactDangerButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
