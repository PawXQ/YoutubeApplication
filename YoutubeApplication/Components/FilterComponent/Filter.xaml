<UserControl
    x:Class="YoutubeApplication.Components.FilterComponent.Filter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApplication.Components.FilterComponent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  欄位標題文字  -->
        <Style x:Key="FilterHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  欄位標題前的強調色條  -->
        <Style x:Key="FilterHeaderAccent" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#60A5FA" />
                        <GradientStop Offset="1" Color="#2563EB" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  列表式單選項目（圓點 + 文字，整列可點）  -->
        <Style x:Key="FilterRowStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Padding="10,8"
                            Background="Transparent"
                            CornerRadius="6"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  圓形單選指示器  -->
                                <Grid
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="Ring"
                                        Fill="White"
                                        Stroke="#D1D5DB"
                                        StrokeThickness="1.5" />
                                    <Ellipse
                                        x:Name="Dot"
                                        Width="8"
                                        Height="8"
                                        Fill="#2563EB"
                                        Visibility="Collapsed" />
                                </Grid>

                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F9FAFB" />
                                <Setter TargetName="Ring" Property="Stroke" Value="#9CA3AF" />
                                <Setter Property="Foreground" Value="#111827" />
                            </Trigger>
                            <!--  放在最後，選取狀態優先於 Hover  -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Ring" Property="Stroke" Value="#2563EB" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  共用選項範本  -->
        <DataTemplate x:Key="FilterItemTemplate">
            <RadioButton
                Command="{Binding SearchTypeItems}"
                CommandParameter="{Binding Title}"
                Content="{Binding Title}"
                GroupName="{Binding GroupName}"
                IsChecked="{Binding IsChecked}"
                Style="{StaticResource FilterRowStyle}" />
        </DataTemplate>

    </UserControl.Resources>

    <!--  外層卡片（帶陰影）  -->
    <Border
        Margin="14"
        Padding="24,20"
        Background="White"
        BorderBrush="#EEF0F3"
        BorderThickness="1"
        CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Direction="270"
                Opacity="0.10"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  五個欄位  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Type  -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Margin="10,0,0,12" Orientation="Horizontal">
                        <Border Style="{StaticResource FilterHeaderAccent}" />
                        <TextBlock Style="{StaticResource FilterHeaderText}" Text="TYPE" />
                    </StackPanel>
                    <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding SearchTypeItems}" />
                </StackPanel>

                <!--  VideoDuration  -->
                <Border
                    Grid.Column="1"
                    Padding="12,0"
                    BorderBrush="#F3F4F6"
                    BorderThickness="1,0,0,0">
                    <StackPanel>
                        <StackPanel Margin="10,0,0,12" Orientation="Horizontal">
                            <Border Style="{StaticResource FilterHeaderAccent}" />
                            <TextBlock Style="{StaticResource FilterHeaderText}" Text="VIDEO DURATION" />
                        </StackPanel>
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding VideoDurationItems}" />
                    </StackPanel>
                </Border>

                <!--  VideoDefinition  -->
                <Border
                    Grid.Column="2"
                    Padding="12,0"
                    BorderBrush="#F3F4F6"
                    BorderThickness="1,0,0,0">
                    <StackPanel>
                        <StackPanel Margin="10,0,0,12" Orientation="Horizontal">
                            <Border Style="{StaticResource FilterHeaderAccent}" />
                            <TextBlock Style="{StaticResource FilterHeaderText}" Text="VIDEO DEFINITION" />
                        </StackPanel>
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding VideoDefinitionItems}" />
                    </StackPanel>
                </Border>

                <!--  VideoType  -->
                <Border
                    Grid.Column="3"
                    Padding="12,0"
                    BorderBrush="#F3F4F6"
                    BorderThickness="1,0,0,0">
                    <StackPanel>
                        <StackPanel Margin="10,0,0,12" Orientation="Horizontal">
                            <Border Style="{StaticResource FilterHeaderAccent}" />
                            <TextBlock Style="{StaticResource FilterHeaderText}" Text="VIDEO TYPE" />
                        </StackPanel>
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding VideoTypeItems}" />
                    </StackPanel>
                </Border>

                <!--  PublishedAfter  -->
                <Border
                    Grid.Column="4"
                    Padding="12,0,0,0"
                    BorderBrush="#F3F4F6"
                    BorderThickness="1,0,0,0">
                    <StackPanel>
                        <StackPanel Margin="10,0,0,12" Orientation="Horizontal">
                            <Border Style="{StaticResource FilterHeaderAccent}" />
                            <TextBlock Style="{StaticResource FilterHeaderText}" Text="PUBLISHED AFTER" />
                        </StackPanel>
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding PublishedAfterItems}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
