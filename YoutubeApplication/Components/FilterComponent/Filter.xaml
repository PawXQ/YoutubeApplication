<UserControl
    x:Class="YoutubeApplication.Components.FilterComponent.Filter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApplication.Components.FilterComponent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  第一個 Column：Type (放在 Grid.Column="0")  -->
        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,10,10"
                Padding="0,0,0,8"
                BorderBrush="DarkGray"
                BorderThickness="0,0,0,1">
                <TextBlock Foreground="White" Text="TYPE" />
                <!--  顏色可依你的背景微調  -->
            </Border>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding SearchTypeItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>

                            <RadioButton
                                Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="12,4"
                                Command="{Binding SearchTypeItems}"
                                CommandParameter="{Binding Title}"
                                Content="{Binding Title}"
                                GroupName="{Binding GroupName}"
                                IsChecked="{Binding IsChecked}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--  第二個 Column：Duration (放在 Grid.Column="1")  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,10,10"
                Padding="0,0,0,8"
                BorderBrush="DarkGray"
                BorderThickness="0,0,0,1">
                <TextBlock Foreground="White" Text="VideoDuration" />
                <!--  顏色可依你的背景微調  -->
            </Border>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding VideoDurationItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>

                            <RadioButton
                                Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="12,4"
                                Command="{Binding SearchTypeItems}"
                                CommandParameter="{Binding Title}"
                                Content="{Binding Title}"
                                GroupName="{Binding GroupName}"
                                IsChecked="{Binding IsChecked}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--  第三個 Column：VideoDeginition (放在 Grid.Column="2")  -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,10,10"
                Padding="0,0,0,8"
                BorderBrush="DarkGray"
                BorderThickness="0,0,0,1">
                <TextBlock Foreground="White" Text="VideoDefinition" />
                <!--  顏色可依你的背景微調  -->
            </Border>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding VideoDefinitionItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>

                            <RadioButton
                                Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="12,4"
                                Command="{Binding SearchTypeItems}"
                                CommandParameter="{Binding Title}"
                                Content="{Binding Title}"
                                GroupName="{Binding GroupName}"
                                IsChecked="{Binding IsChecked}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--  第三個 Column：VideoType (放在 Grid.Column="3")  -->
        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,10,10"
                Padding="0,0,0,8"
                BorderBrush="DarkGray"
                BorderThickness="0,0,0,1">
                <TextBlock Foreground="White" Text="VideoType" />
                <!--  顏色可依你的背景微調  -->
            </Border>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding VideoTypeItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>

                            <RadioButton
                                Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="12,4"
                                Command="{Binding SearchTypeItems}"
                                CommandParameter="{Binding Title}"
                                Content="{Binding Title}"
                                GroupName="{Binding GroupName}"
                                IsChecked="{Binding IsChecked}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--  第五個 Column：Upload Date (放在 Grid.Column="4")  -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,10,10"
                Padding="0,0,0,8"
                BorderBrush="DarkGray"
                BorderThickness="0,0,0,1">
                <TextBlock Foreground="White" Text="PublishedAfter" />
                <!--  顏色可依你的背景微調  -->
            </Border>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding PublishedAfterItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>

                            <RadioButton
                                Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="12,4"
                                Command="{Binding SearchTypeItems}"
                                CommandParameter="{Binding Title}"
                                Content="{Binding Title}"
                                GroupName="{Binding GroupName}"
                                IsChecked="{Binding IsChecked}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
