<UserControl
    x:Class="YoutubeApplication.Components.FilterComponent.Filter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApplication.Components.FilterComponent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  第一個 Column：Type (放在 Grid.Column="0")  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--<Border
     Grid.Row="0"
     Margin="0,0,10,10"
     Padding="0,0,0,8"
     BorderBrush="DarkGray"
     BorderThickness="0,0,0,1">
     <TextBlock Foreground="Black" Text="TYPE" />
            -->
            <!--  顏色可依你的背景微調  -->
            <!--
 </Border>-->

            <RadioButton
                Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,4"
                Command="{Binding SearchTypeCommand}"
                CommandParameter="channel"
                Content="channel"
                GroupName="SearchType" />

            <RadioButton
                Grid.Row="2"
                Margin="0,0,0,10"
                Padding="12,4"
                Command="{Binding SearchTypeCommand}"
                CommandParameter="playlist"
                Content="playlist"
                GroupName="SearchType" />

            <RadioButton
                Grid.Row="3"
                Margin="0,0,0,10"
                Padding="12,4"
                Command="{Binding SearchTypeCommand}"
                CommandParameter="video"
                Content="video"
                GroupName="SearchType" />
        </Grid>

        <!--  第二個 Column：Duration (放在 Grid.Column="1")  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <RadioButton
                Grid.Row="0"
                Margin="0,0,0,10"
                Padding="12,4"
                Command="{Binding VideoDurationCommand}"
                CommandParameter="short"
                Content="short"
                GroupName="VideoDurationType" />

            <RadioButton
                Grid.Row="1"
                Padding="12,4"
                Command="{Binding VideoDurationCommand}"
                CommandParameter="long"
                Content="long"
                GroupName="VideoDurationType" />
        </Grid>

        <!--  第三個 Column：VideoDeginition (放在 Grid.Column="2")  -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <RadioButton
                Grid.Row="0"
                Margin="0,0,0,10"
                Padding="12,4"
                Command="{Binding VideoDefinitionCommand}"
                CommandParameter="high"
                Content="high"
                GroupName="VideoDefinitionType" />

            <RadioButton
                Grid.Row="1"
                Padding="12,4"
                Command="{Binding VideoDefinitionCommand}"
                CommandParameter="standard"
                Content="standard"
                GroupName="VideoDefinitionType" />
        </Grid>

        <!--  第三個 Column：VideoType (放在 Grid.Column="3")  -->
        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <RadioButton
                Grid.Row="0"
                Margin="0,0,0,10"
                Padding="12,4"
                Command="{Binding VideoTypeCommand}"
                CommandParameter="episode"
                Content="episode"
                GroupName="VideoDefinitionType" />

            <RadioButton
                Grid.Row="1"
                Padding="12,4"
                Command="{Binding VideoTypeCommand}"
                CommandParameter="movie"
                Content="movie"
                GroupName="VideoDefinitionType" />
        </Grid>

        <!--  第五個 Column：Upload Date (放在 Grid.Column="4")  -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <RadioButton
                Grid.Row="0"
                Margin="0,0,0,10"
                Padding="12,4"
                Command="{Binding PublishedAfterCommand}"
                CommandParameter="today"
                Content="today"
                GroupName="PublishedAfterType" />

            <RadioButton
                Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,4"
                Command="{Binding PublishedAfterCommand}"
                CommandParameter="this_week"
                Content="this week"
                GroupName="PublishedAfterType" />

            <RadioButton
                Grid.Row="2"
                Padding="12,4"
                Command="{Binding PublishedAfterCommand}"
                CommandParameter="this_month"
                Content="this month"
                GroupName="PublishedAfterType" />
        </Grid>
    </Grid>
</UserControl>
