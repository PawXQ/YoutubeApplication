<UserControl
    x:Class="YoutubeApplication.Components.FilterComponent.Filter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApplication.Components.FilterComponent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  欄位分隔線  -->
        <Style x:Key="FilterColumn" TargetType="Border">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>

        <!--  列表式單選項目：滑過銀白光暈，選中為金屬反光淡底  -->
        <Style x:Key="FilterRowStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Padding="8,7"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  金屬風格單選鈕  -->
                                <Grid
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="Ring"
                                        Fill="{StaticResource InputBackgroundBrush}"
                                        Stroke="{StaticResource BorderStrongBrush}"
                                        StrokeThickness="1" />
                                    <Ellipse
                                        x:Name="Dot"
                                        Width="6"
                                        Height="6"
                                        Fill="{StaticResource TextDarkBrush}"
                                        Visibility="Collapsed" />
                                </Grid>

                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HighlightBorderBrush}" />
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource HoverGlow}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource HighlightBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <!--  放在最後，選取狀態優先於 Hover  -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter TargetName="Ring" Property="Fill" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource HighlightBorderBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  共用選項範本  -->
        <DataTemplate x:Key="FilterItemTemplate">
            <RadioButton
                CommandParameter="{Binding Title}"
                Content="{Binding Title}"
                GroupName="{Binding GroupName}"
                IsChecked="{Binding IsChecked}"
                Style="{StaticResource FilterRowStyle}" />
        </DataTemplate>

    </UserControl.Resources>

    <!--  Popup 外層金屬面板  -->
    <Border
        Margin="20"
        CornerRadius="10"
        Effect="{StaticResource PanelShadow}"
        Style="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Popup MessageBox 頂部 Banner：髮絲紋槍灰金屬漸層  -->
            <Border
                Grid.Row="0"
                Padding="18,12"
                Background="{StaticResource BannerBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="10,10,0,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="13"
                            Foreground="{StaticResource TextBrush}"
                            Text="&#xE71C;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            Text="Search Filters" />
                    </StackPanel>

                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding ConfirmFilterCommand}"
                        Content="Apply filters"
                        Style="{StaticResource PrimaryButton}" />
                </Grid>
            </Border>

            <!--  五個欄位  -->
            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Type  -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock
                        Margin="8,0,0,10"
                        Style="{StaticResource SectionHeader}"
                        Text="TYPE" />
                    <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding SearchTypeItems}" />
                </StackPanel>

                <!--  VideoDuration  -->
                <Border Grid.Column="1" Style="{StaticResource FilterColumn}">
                    <StackPanel>
                        <TextBlock
                            Margin="8,0,0,10"
                            Style="{StaticResource SectionHeader}"
                            Text="VIDEO DURATION" />
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding VideoDurationItems}" />
                    </StackPanel>
                </Border>

                <!--  VideoDefinition  -->
                <Border Grid.Column="2" Style="{StaticResource FilterColumn}">
                    <StackPanel>
                        <TextBlock
                            Margin="8,0,0,10"
                            Style="{StaticResource SectionHeader}"
                            Text="VIDEO DEFINITION" />
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding VideoDefinitionItems}" />
                    </StackPanel>
                </Border>

                <!--  VideoType  -->
                <Border Grid.Column="3" Style="{StaticResource FilterColumn}">
                    <StackPanel>
                        <TextBlock
                            Margin="8,0,0,10"
                            Style="{StaticResource SectionHeader}"
                            Text="VIDEO TYPE" />
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding VideoTypeItems}" />
                    </StackPanel>
                </Border>

                <!--  PublishedAfter  -->
                <Border
                    Grid.Column="4"
                    Padding="12,0,0,0"
                    Style="{StaticResource FilterColumn}">
                    <StackPanel>
                        <TextBlock
                            Margin="8,0,0,10"
                            Style="{StaticResource SectionHeader}"
                            Text="PUBLISHED AFTER" />
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding PublishedAfterItems}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
