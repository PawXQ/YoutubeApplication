<Window
    x:Class="YoutubeApplication.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApplication"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">


    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="35*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="1"
                Margin="0,0,10,0"
                Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

            <Button
                Grid.Column="2"
                Padding="12,4"
                Command="{Binding ClickCommand}"
                CommandParameter="{Binding}">
                Search
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <!--  加入滾動條，避免影片卡片過多時超出畫面  -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SearchVideos}">
                    <!--  1. 將項目的排列容器改為 WrapPanel（由左至右，空間不夠自動換行）  -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!--  2. 每部影片卡片的排版：內部資訊由上往下排  -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  卡片外框：設定固定寬度、邊距，內部上下排列  -->
                            <Border
                                Width="240"
                                Margin="10"
                                Padding="10"
                                Background="#F9F9F9"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Orientation="Vertical">
                                    <!--  影片縮圖（若有 ImageUrl 可用 Image 控制項）  -->
                                    <Image
                                        Height="135"
                                        Margin="0,0,0,8"
                                        Source="{Binding snippet.thumbnails.medium.url}"
                                        Stretch="UniformToFill" />

                                    <!--  影片標題  -->
                                    <TextBlock
                                        MaxHeight="40"
                                        Margin="0,0,0,6"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{Binding snippet.title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />

                                    <!--  頻道名稱  -->
                                    <TextBlock
                                        Margin="0,0,0,2"
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="{Binding snippet.channelTitle}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--  影片 ID 或發布時間  -->
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#888888"
                                        Text="{Binding id.videoId}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
