<Window
    x:Class="YoutubeApplication.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:YoutubeApplication.ValueConverter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApplication"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="1368"
    Height="817"
    Background="#0F0F0F"
    mc:Ignorable="d">

    <Window.Resources>
        <converter:TimeDurationConverter x:Key="TimeDurationConverter" />
        <converter:PublishedAtConverter x:Key="PublishedAtConverter" />

        <!--  暗黑模式色彩  -->
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F1F1" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAAAAA" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#121212" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#303030" />
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#272727" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3F3F3F" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#505050" />

        <!--  暗黑搜尋框  -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3EA6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  暗黑按鈕  -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  搜尋列  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="1"
                Margin="0,0,10,0"
                Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

            <Button
                Grid.Column="2"
                Padding="18,7"
                Command="{Binding ClickCommand}"
                CommandParameter="{Binding}">
                Search
            </Button>
        </Grid>

        <!--  影片清單  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,20,0,0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SearchVideos}">

                <!--  由左至右排列，空間不夠自動換行  -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!--  單一影片卡片（YouTube 暗黑樣式）  -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="300" Margin="8,0,8,24">

                            <!--  縮圖（圓角）+ 右下角時長標籤  -->
                            <Grid Height="169">
                                <Rectangle
                                    Fill="#272727"
                                    RadiusX="12"
                                    RadiusY="12" />
                                <Rectangle RadiusX="12" RadiusY="12">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding videoThumbnails}" Stretch="UniformToFill" />
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Border
                                    Margin="0,0,8,8"
                                    Padding="5,1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#CC000000"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding duration, Converter={StaticResource TimeDurationConverter}}" />
                                </Border>
                            </Grid>

                            <!--  下方資訊列：左邊圓形頭像，右邊文字  -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  頻道頭像  -->
                                <Ellipse
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding channelThumbnails}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>

                                <StackPanel Grid.Column="1">
                                    <!--  標題（最多兩行）  -->
                                    <TextBlock
                                        MaxHeight="40"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="{Binding title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        ToolTip="{Binding title}" />

                                    <!--  頻道名稱  -->
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="{Binding channelTitle}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--  觀看次數 • 上傳時間  -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="{Binding viewCount}" />
                                        <TextBlock
                                            Margin="4,0"
                                            FontSize="12"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="•" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="{Binding publishedAt, Converter={StaticResource PublishedAtConverter}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
